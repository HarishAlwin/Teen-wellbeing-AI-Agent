# ── Gemini (LLM) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Deepgram (Speech-to-Text) ─────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── ElevenLabs (Text-to-Speech) ───────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel voice (warm, empathetic)

# ── PostgreSQL ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/teen_wellbeing

# ── App ───────────────────────────────────────────────
SECRET_KEY=change_me_in_production_random_32_chars
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Default Region for Helplines ─────────────────────
DEFAULT_COUNTRY=IN

# ── Escalation Service (Task 1) ───────────────────────
# Set to true to enable SMTP email alerts when HIGH_CONCERN/IMMEDIATE_SAFETY is triggered.
# Leave false (default) to use DB-only logging without email.
ESCALATION_EMAIL_ENABLED=false

# SMTP configuration (only required if ESCALATION_EMAIL_ENABLED=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_sender@gmail.com
SMTP_PASS=your_smtp_app_password
ALERT_RECIPIENT_EMAIL=counselor@yourschool.org

