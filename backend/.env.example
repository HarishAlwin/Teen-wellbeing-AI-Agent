# ── Gemini (LLM) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Deepgram (Speech-to-Text) ─────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── ElevenLabs (Text-to-Speech) ───────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel voice (warm, empathetic)

# ── PostgreSQL ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/teen_wellbeing

# ── App ───────────────────────────────────────────────
SECRET_KEY=change_me_in_production_random_32_chars
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Default Region for Helplines ─────────────────────
DEFAULT_COUNTRY=IN

# ── Escalation (AI Phone Call / SMS to a Counselor) ─────────────
# Keep this false during development/testing so no real call or SMS ever
# fires while you're testing crisis-language handling. Every escalation is
# still logged to the database (see /api/alerts) regardless of this flag.
ESCALATION_ENABLED=false

# The number that receives the alert call/SMS — e.g. a counselor, guardian,
# or your own test phone number while developing.
HELPLINE_ALERT_NUMBER=+10000000000

# ── Primary Escalation Channel: CALL-E (AI Agent Phone Calling) ──
# Get your API key at https://heycall-e.com (Docs: https://docs.heycall-e.com/)
CALLE_API_KEY=your_calle_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_RECIPIENT_REGION=IN
CALLE_RECIPIENT_LOCALE=en-IN

# ── Fallback Escalation Channel: Twilio (Static Voice Call & SMS) ─
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+10000000000

