# ══════════════════════════════════════════════════════════════════════════════
# Teen Wellbeing Intelligence — Environment Variables Reference
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq API (Primary LLM + OCR Vision) ──────────────────────────────────────
# Create a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# Fast cheap model used by background specialist agents (never blocks the chat response)
GROQ_SPECIALIST_MODEL=llama-3.1-8b-instant

# ── Gemini API (Fallback LLM) ─────────────────────────────────────────────────
# Create a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Deepgram (Speech-to-Text) ─────────────────────────────────────────────────
# Create a key at: https://console.deepgram.com/project/api-keys
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── ElevenLabs (Text-to-Speech) ───────────────────────────────────────────────
# Create a key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel voice (warm, empathetic)

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev, zero setup):
DATABASE_URL=sqlite:///./teen_wellbeing.db
# PostgreSQL (production / Docker):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/teen_wellbeing

# ══════════════════════════════════════════════════════════════════════════════
# NEW IN v2.0 — Variables added by the security & architecture upgrade
# ══════════════════════════════════════════════════════════════════════════════

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 32 characters. Use a different value in every environment.
JWT_SECRET_KEY=change_me_generate_with_secrets_token_hex_64
JWT_ALGORITHM=HS256
# Full-account session lifetime in minutes (default = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Guest/demo session lifetime in minutes (default = 1 hour)
GUEST_TOKEN_EXPIRE_MINUTES=60

# ── Background Specialist Agents ─────────────────────────────────────────────
# No broker required — specialist agents run in FastAPI BackgroundTasks (same process).
# No Redis/Celery needed. GROQ_SPECIALIST_MODEL above controls which model they use.

# ── Escalation: Admin/Counselor Email Channel ────────────────────────────────
# Set ESCALATION_EMAIL_ENABLED=true to send SMTP alerts to a counselor inbox
# when HIGH_CONCERN or IMMEDIATE_SAFETY is detected.
# Default is false (DB audit log only — safe to leave off during development).
ESCALATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_sender@gmail.com
# For Gmail: use an App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_char_gmail_app_password
ALERT_RECIPIENT_EMAIL=counselor@yourschool.org

# ── Escalation: Per-User Emergency Contact Notifications ─────────────────────
# Set EMERGENCY_CONTACT_NOTIFY_ENABLED=true to also email a teen's personally
# registered emergency contacts (parent/guardian) on IMMEDIATE_SAFETY events.
# Requires SMTP credentials above to be configured.
# Default is false.
EMERGENCY_CONTACT_NOTIFY_ENABLED=false

# ── Automated Emergency Call & SMS Dispatch ──────────────────────────────────
# When an IMMEDIATE_SAFETY crisis is triggered, the system automatically dispatches
# a priority voice call and SMS to this emergency responder/guardian number with
# the user's latest response and context.
EMERGENCY_AUTO_CALL_ENABLED=true
EMERGENCY_DISPATCH_PHONE_NUMBER=

# (Optional) Twilio Live PSTN credentials for outbound phone calls:
# If left blank, full automated voice dispatch is logged in audit database.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Default Region for Helplines ─────────────────────────────────────────────
DEFAULT_COUNTRY=IN

